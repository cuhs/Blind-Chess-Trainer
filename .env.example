# Copy to .env.local (repo root or apps/mobile — app.config.js loads both)
# Local Supabase: keep 127.0.0.1 — Expo Go on a physical phone rewrites to your LAN IP in dev.
# Phone and Mac must be on the same Wi‑Fi; run `supabase start` on the Mac.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
