# Copy to .env.local (repo root or apps/mobile — app.config.js loads both)
# User-managed secrets — do not commit .env.local; agents must not edit it.
#
# Cloud Supabase (default) — use publishable key, not legacy anon JWT
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>
#
# Dashboard: Project Settings → API → API Keys tab → Publishable key
# One-time: Authentication → Providers → Anonymous sign-ins
# Schema:   supabase login && supabase link --project-ref <ref> && supabase db push
# Seed:     supabase db execute --linked -f supabase/seed.sql
# Auth:     supabase config push
#
# After the app works with the publishable key, disable legacy anon/service_role
# keys in Dashboard → Project Settings → API → Legacy API Keys.
#
# Server only (apps/api, Edge Functions) — never in the mobile bundle:
# SUPABASE_SECRET_KEY=sb_secret_<your-key>
#
# Optional — local Docker only (legacy anon from `supabase status` still works):
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<local-anon-from-supabase-status>
