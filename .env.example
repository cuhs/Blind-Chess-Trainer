# Copy to .env.local (repo root or apps/mobile — app.config.js loads both)
# Local Supabase: keep 127.0.0.1 — physical devices rewrite to your LAN IP in dev.
# iOS Simulator keeps 127.0.0.1 (same machine as `supabase start`).
# Run `supabase start` on the Mac before training flows.
# Dev client (npm run ios:build) needs NSAllowsLocalNetworking — set in app.json; rebuild after changing it.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
